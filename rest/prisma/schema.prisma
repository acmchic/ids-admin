generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model catalog {
  id            Int     @id @default(autoincrement())
  name          String
  slug          String  @unique
  price         Float   @default(1)
  base_price    Float   @default(22)
  description   Json
  size_info     Json
  mockup_img    String
  print_areas   Json
  variants      Json
  status        Boolean
  is_home_page  Boolean
  color_default String
  bg_default    String?
}

model address {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String
  type        String
  default     Boolean   @default(false)
  address     Json
  customer_id BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "address_customer_id_foreign")

  @@index([customer_id], map: "address_customer_id_foreign")
}

model attachments {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  url        String    @default("")
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model attribute_product {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  attribute_value_id BigInt           @db.UnsignedBigInt
  product_id         BigInt           @db.UnsignedBigInt
  created_at         DateTime?        @db.Timestamp(0)
  updated_at         DateTime?        @db.Timestamp(0)
  attribute_values   attribute_values @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_product_attribute_value_id_foreign")
  products           products         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_product_product_id_foreign")

  @@index([attribute_value_id], map: "attribute_product_attribute_value_id_foreign")
  @@index([product_id], map: "attribute_product_product_id_foreign")
}

model attribute_values {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  attribute_id      BigInt              @db.UnsignedBigInt
  value             String
  meta              String?
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  attribute_product attribute_product[]
  attributes        attributes          @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_values_attribute_id_foreign")

  @@index([attribute_id], map: "attribute_values_attribute_id_foreign")
}

model attributes {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  slug             String
  name             String
  shop_id          BigInt?            @db.UnsignedBigInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  attribute_values attribute_values[]
  shops            shops?             @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attributes_shop_id_foreign")

  @@index([shop_id], map: "attributes_shop_id_foreign")
}

model balances {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id               BigInt    @db.UnsignedBigInt
  admin_commission_rate Float?
  total_earnings        Float     @default(0)
  withdrawn_amount      Float     @default(0)
  current_balance       Float     @default(0)
  payment_info          Json?
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  shops                 shops     @relation(fields: [shop_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "balances_shop_id_foreign")

  @@index([shop_id], map: "balances_shop_id_foreign")
}

model banners {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type_id     BigInt    @db.UnsignedBigInt
  title       String    @db.Text
  description String?   @db.Text
  image       Json?
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  types       types     @relation(fields: [type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "banners_type_id_foreign")

  @@index([type_id], map: "banners_type_id_foreign")
}

model categories {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name             String
  slug             String
  icon             String?
  image            Json?
  banner_image     Json?
  details          String?            @db.Text
  parent           BigInt?            @db.UnsignedBigInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  deleted_at       DateTime?          @db.Timestamp(0)
  categories       categories?        @relation("categoriesTocategories", fields: [parent], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_parent_foreign")
  other_categories categories[]       @relation("categoriesTocategories")
  category_product category_product[]
  category_shop    category_shop[]

  @@index([parent], map: "categories_parent_foreign")
}

model category_product {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  product_id  BigInt     @db.UnsignedBigInt
  category_id BigInt     @db.UnsignedBigInt
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_product_category_id_foreign")
  products    products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_product_product_id_foreign")

  @@index([category_id], map: "category_product_category_id_foreign")
  @@index([product_id], map: "category_product_product_id_foreign")
}

model category_shop {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id     BigInt     @db.UnsignedBigInt
  category_id BigInt     @db.UnsignedBigInt
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_shop_category_id_foreign")
  shops       shops      @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_shop_shop_id_foreign")

  @@index([category_id], map: "category_shop_category_id_foreign")
  @@index([shop_id], map: "category_shop_shop_id_foreign")
}

model coupons {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  code        String
  description String?      @db.Text
  image       Json?
  type        coupons_type @default(fixed)
  amount      Float        @default(0.00)
  active_from String
  expire_at   String
  created_at  DateTime?    @db.Timestamp(0)
  updated_at  DateTime?    @db.Timestamp(0)
  deleted_at  DateTime?    @db.Timestamp(0)
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique")
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model media {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  model_type            String
  model_id              BigInt    @db.UnsignedBigInt
  uuid                  String?   @db.Char(36)
  collection_name       String
  name                  String
  file_name             String
  mime_type             String?
  disk                  String
  conversions_disk      String?
  size                  BigInt    @db.UnsignedBigInt
  manipulations         Json
  generated_conversions Json
  custom_properties     Json
  responsive_images     Json
  order_column          Int?      @db.UnsignedInt
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)

  @@index([model_type, model_id], map: "media_model_type_model_id_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String
  batch     Int
}

model model_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  model_type    String
  model_id      BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_permissions_permission_id_foreign")

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt @db.UnsignedBigInt
  model_type String
  model_id   BigInt @db.UnsignedBigInt
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

model order_product {
  id                  BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  order_id            BigInt             @db.UnsignedBigInt
  product_id          BigInt             @db.UnsignedBigInt
  variation_option_id BigInt?            @db.UnsignedBigInt
  variation          Json
  order_quantity      String
  unit_price          Float
  subtotal            Float
  deleted_at          DateTime?          @db.Timestamp(0)
  created_at          DateTime?          @db.Timestamp(0)
  updated_at          DateTime?          @db.Timestamp(0)
  orders              orders             @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_product_order_id_foreign")
  products            products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_product_product_id_foreign")
  variation_options   variation_options? @relation(fields: [variation_option_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_product_variation_option_id_foreign")
  img_url             String?

  @@index([order_id], map: "order_product_order_id_foreign")
  @@index([product_id], map: "order_product_product_id_foreign")
  @@index([variation_option_id], map: "order_product_variation_option_id_foreign")
}

model order_status {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  serial     Int
  color      String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  orders     orders[]
}

model orders {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tracking_number    String          @unique(map: "orders_tracking_number_unique")
  customer_id        BigInt?         @db.UnsignedBigInt
  customer_contact   String?
  status             BigInt          @db.UnsignedBigInt
  email_send          Int             @default(0)
  amount             Float
  sales_tax          Float?
  paid_total         Float?
  total              Float?
  coupon_id          BigInt?         @db.UnsignedBigInt
  parent_id          BigInt?         @db.UnsignedBigInt
  shop_id            BigInt?         @db.UnsignedBigInt
  discount           Float?
  payment_id         String?
  payment_status     String?
  payment_gateway    String?
  shipping_address   Json?
  billing_address    Json?
  logistics_provider BigInt?         @db.UnsignedBigInt
  delivery_fee       Float?
  delivery_time      String?
  deleted_at         DateTime?       @db.Timestamp(0)
  created_at         DateTime?       @db.Timestamp(0)
  updated_at         DateTime?       @db.Timestamp(0)
  order_product      order_product[]
  issues             issues[]
  orders             orders?         @relation("ordersToorders", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orders_parent_id_foreign")
  other_orders       orders[]        @relation("ordersToorders")
  order_status       order_status    @relation(fields: [status], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_status_foreign")

  @@index([customer_id], map: "orders_customer_id_foreign")
  @@index([parent_id], map: "orders_parent_id_foreign")
  @@index([status], map: "orders_status_foreign")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_resets {
  email      String
  token      String
  created_at DateTime? @db.Timestamp(0)

  @@index([email], map: "password_resets_email_index")
  @@ignore
}

model permissions {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String
  guard_name            String
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  model_has_permissions model_has_permissions[]
  role_has_permissions  role_has_permissions[]
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model product_tag {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt   @db.UnsignedBigInt
  tag_id     BigInt   @db.UnsignedBigInt
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_tag_product_id_foreign")
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_tag_tag_id_foreign")

  @@index([product_id], map: "product_tag_product_id_foreign")
  @@index([tag_id], map: "product_tag_tag_id_foreign")
}

model products {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  name              String
  slug              String
  description       String?               @db.Text
  price             Float?
  sale_price        Float?
  sku               String?
  quantity          Int                   @default(0)
  in_stock          Boolean               @default(true)
  is_taxable        Boolean               @default(false)
  shipping_class_id BigInt?               @db.UnsignedBigInt
  status            products_status       @default(publish)
  product_type      products_product_type @default(simple)
  unit              String
  height            String?
  width             String?
  length            String?
  image             Json?
  gallery           Json?
  deleted_at        DateTime?             @db.Timestamp(0)
  created_at        DateTime?             @db.Timestamp(0)
  updated_at        DateTime?             @db.Timestamp(0)
  max_price         Float?
  min_price         Float?
  video             Json?
  attribute_product attribute_product[]
  category_product  category_product[]
  order_product     order_product[]
  product_tag       product_tag[]
  shipping_classes  shipping_classes?     @relation(fields: [shipping_class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_shipping_class_id_foreign")
  variation_options variation_options[]

  @@index([shipping_class_id], map: "products_shipping_classc_id_foreign")
}

model products_copy {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  name              String
  slug              String
  description       String?               @db.Text
  price             Float?
  sale_price        Float?
  sku               String?
  quantity          Int                   @default(0)
  in_stock          Boolean               @default(true)
  is_taxable        Boolean               @default(false)
  shipping_class_id BigInt?               @db.UnsignedBigInt
  status            products_status       @default(publish)
  product_type      products_product_type @default(simple)
  unit              String
  height            String?
  width             String?
  length            String?
  image             Json?
  gallery           Json?
  deleted_at        DateTime?             @db.Timestamp(0)
  created_at        DateTime?             @db.Timestamp(0)
  updated_at        DateTime?             @db.Timestamp(0)
  max_price         Float?
  min_price         Float?
  video             Json?
}

model providers {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt    @db.UnsignedBigInt
  provider_user_id String
  provider         String
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "providers_user_id_foreign")

  @@index([user_id], map: "providers_user_id_foreign")
}

model role_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  role_id       BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_permission_id_foreign")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_role_id_foreign")

  @@id([permission_id, role_id])
  @@index([role_id], map: "role_has_permissions_role_id_foreign")
}

model roles {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String
  guard_name           String
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  model_has_roles      model_has_roles[]
  role_has_permissions role_has_permissions[]
}

model settings {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  options    Json
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model shipping_classes {
  id         BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  amount     Float
  is_global  String                @default("1")
  type       shipping_classes_type @default(fixed)
  created_at DateTime?             @db.Timestamp(0)
  updated_at DateTime?             @db.Timestamp(0)
  products   products[]
}

model shops {
  id                          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  owner_id                    BigInt          @db.UnsignedBigInt
  name                        String?
  slug                        String?
  description                 String?         @db.Text
  cover_image                 Json?
  logo                        Json?
  is_active                   Boolean         @default(false)
  address                     Json?
  settings                    Json?
  created_at                  DateTime?       @db.Timestamp(0)
  updated_at                  DateTime?       @db.Timestamp(0)
  attributes                  attributes[]
  balances                    balances[]
  category_shop               category_shop[]
  users_shops_owner_idTousers users           @relation("shops_owner_idTousers", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "shops_owner_id_foreign")
  users_users_shop_idToshops  users[]         @relation("users_shop_idToshops")
  withdraws                   withdraws[]

  @@index([owner_id], map: "shops_owner_id_foreign")
}

model tags {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name        String
  slug        String
  icon        String?
  image       Json?
  details     String?       @db.Text
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  deleted_at  DateTime?     @db.Timestamp(0)
  product_tag product_tag[]
}

model tax_classes {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  country     String?
  state       String?
  zip         String?
  city        String?
  rate        Float
  name        String?
  is_global   Int?
  priority    Int?
  on_shipping Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model types {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                String
  settings            Json?
  slug                String
  icon                String?
  promotional_sliders Json?
  images              Json?
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  banners             banners[]
}

model user_profiles {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  avatar      Json?
  bio         String?   @db.Text
  socials     Json?
  contact     String?
  customer_id BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_profiles_customer_id_foreign")

  @@index([customer_id], map: "user_profiles_customer_id_foreign")
}

model issues {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id     BigInt    @db.UnsignedBigInt
  issue_type   String
  status       String    @default("open")
  old_data     Json?
  new_data     Json?
  notes        String?   @db.Text
  created_by   String?
  resolved_at  DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  orders       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "issues_order_id_foreign")

  @@index([order_id], map: "issues_order_id_foreign")
  @@index([status], map: "issues_status_index")
  @@index([issue_type], map: "issues_issue_type_index")
}

model users {
  id                          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  name                        String
  email                       String          @unique(map: "users_email_unique")
  email_verified_at           DateTime?       @db.Timestamp(0)
  password                    String?
  remember_token              String?         @db.VarChar(100)
  created_at                  DateTime?       @db.Timestamp(0)
  updated_at                  DateTime?       @db.Timestamp(0)
  is_active                   Boolean         @default(true)
  shop_id                     BigInt?         @db.UnsignedBigInt
  address                     address[]
  providers                   providers[]
  shops_shops_owner_idTousers shops[]         @relation("shops_owner_idTousers")
  user_profiles               user_profiles[]
  shops_users_shop_idToshops  shops?          @relation("users_shop_idToshops", fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "users_shop_id_foreign")

  @@index([shop_id], map: "users_shop_id_foreign")
}

model variation_options {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  title         String
  price         Float
  sale_price    Float?
  quantity      Int             @default(0)
  is_disable    Boolean         @default(false)
  sku           String?
  options       Json
  product_id    BigInt?         @db.UnsignedBigInt
  created_at    DateTime?       @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  order_product order_product[]
  products      products?       @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "variation_options_product_id_foreign")

  @@index([product_id], map: "variation_options_product_id_foreign")
}

model withdraws {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id        BigInt           @db.UnsignedBigInt
  amount         Float
  payment_method String?
  status         withdraws_status @default(pending)
  details        String?          @db.Text
  note           String?          @db.Text
  deleted_at     DateTime?        @db.Timestamp(0)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  shops          shops            @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "withdraws_shop_id_foreign")

  @@index([shop_id], map: "withdraws_shop_id_foreign")
}

enum coupons_type {
  fixed
  percentage
  free_shipping
}

enum shipping_classes_type {
  fixed
  percentage
  free_shipping
}

enum withdraws_status {
  approved
  processing
  rejected
  pending
  on_hold
}

enum products_status {
  publish
  draft
}

enum products_product_type {
  simple
  variable
}

model product_images {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt
  product_id           BigInt
  image                String    @db.Text
  name                 String?
  sort_order           Int
  status               Int
  created_time         Int
  status_update_mockup Int
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
}

model contact {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  subject     String
  name        String
  email       String
  description String    @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model product_image {
  id                   Int       @id @default(autoincrement())
  data_lib_id          Int       @default(0)
  is_personalization   Boolean   @default(false)
  user_id              Int       @default(0)
  product_type_id      Int       @default(0)
  related_id           Int       @default(0)
  is_pod               Boolean   @default(false)
  username             String?
  name                 String?
  slug                 String?
  extract              String?
  main_keyword         String?
  default_setting      String?
  price                Float     @default(0)
  price_2              Float     @default(0)
  thumbnail            String?
  image                String?
  image_1              String?
  image_2              String?
  status               Int       @default(0)
  views                Int       @default(0)
  buy_number           Int       @default(0)
  focus                Boolean   @default(false)
  best_selling         Boolean   @default(false)
  tags                 String?
  status_sync          Boolean   @default(false)
  status_sync_image    Boolean   @default(false)
  status_update_mockup Boolean   @default(false)
  custom_label_0       String?
  custom_label_1       String?
  custom_label_2       String?
  custom_label_3       String?
  custom_label_4       String?
  product_type_feed    String?
  product_type_ad_id   Int       @default(0)
  ban_gmc              Boolean   @default(false)
  ban_facebook         Boolean   @default(false)
  daily_gmc            Boolean   @default(false)
  created_at           DateTime?
  updated_at           DateTime?
  es_sync              Boolean   @default(false)
  product_template_id  Int       @default(1)

  @@index([status])
  @@index([user_id])
  @@index([best_selling])
  @@index([focus])
  @@index([product_type_id])
  @@index([related_id])
  @@index([slug])
  @@index([main_keyword])
  @@index([views])
  @@index([status_sync])
  @@index([ban_gmc])
  @@index([daily_gmc])
  @@index([product_type_id, status])
  @@index([id, status])
  @@index([id, related_id])
  @@index([id, product_type_id, main_keyword])
  @@index([es_sync])
  @@index([status_sync_image])
  @@index([status_update_mockup])
  @@index([product_type_ad_id])
  @@index([image])
  @@index([buy_number])
  @@index([ban_facebook])
  @@index([data_lib_id])
  @@fulltext([name])
}

model email_campaigns {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name             String
  subject          String
  preview_text     String?   @db.Text
  heading          String?   @db.Text
  body_html        String?   @db.Text
  discount_code    String?
  discount_percent Int?
  cta_text         String    @default("Shop Now")
  cta_url          String    @default("https://idreamshirt.com")
  status           String    @default("draft")
  total_recipients Int       @default(0)
  sent_count       Int       @default(0)
  failed_count     Int       @default(0)
  opened_count     Int       @default(0)
  batch_size       Int       @default(50)
  started_at       DateTime? @db.Timestamp(0)
  completed_at     DateTime? @db.Timestamp(0)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  recipients       email_campaign_recipients[]
}

model email_campaign_recipients {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  campaign_id   BigInt    @db.UnsignedBigInt
  email         String
  name          String?
  status        String    @default("pending")
  error_message String?   @db.Text
  sent_at       DateTime? @db.Timestamp(0)
  opened_at     DateTime? @db.Timestamp(0)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  campaign      email_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, status])
  @@index([email])
}

model email_unsubscribes {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email           String    @unique
  reason          String?
  unsubscribed_at DateTime  @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([email])
}

model email_contacts {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email          String    @unique
  name           String?
  source         String    @default("order")
  source_detail  String?
  is_active      Boolean   @default(true)
  orders_count   Int       @default(0)
  total_spent    Decimal   @default(0.00) @db.Decimal(10, 2)
  first_order_at DateTime? @db.Timestamp(0)
  last_order_at  DateTime? @db.Timestamp(0)
  tags           Json?
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([is_active])
  @@index([source])
  @@index([orders_count])
}
